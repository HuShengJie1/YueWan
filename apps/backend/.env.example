APP_ENV=development
APP_NAME=MeetUp Vote API
DEBUG=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=meetup_vote
DB_PASSWORD=
DB_NAME=meetup_vote
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
API_V1_PREFIX=/api/v1
WECHAT_APP_ID=
WECHAT_APP_SECRET=
JWT_SECRET=
JWT_ISSUER=meetup-vote-api
JWT_AUDIENCE=meetup-vote-miniprogram
ACCESS_TOKEN_TTL_SECONDS=7200
AVATAR_STORAGE_BACKEND=local
MEDIA_ROOT=var/media
MEDIA_URL_PATH=/media
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8000/media
CLOUDBASE_ENV_ID=
CLOUDBASE_STORAGE_PUBLIC_BASE_URL=
AVATAR_MAX_UPLOAD_BYTES=5242880
AVATAR_MAX_DIMENSION=512
AVATAR_MAX_SOURCE_PIXELS=20000000
AVATAR_JPEG_QUALITY=85
