.list-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 44rpx 36rpx calc(42rpx + env(safe-area-inset-bottom));
  background: #f6f7f2;
}

.center-state {
  display: flex;
  min-height: 76vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  text-align: center;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  color: #a94d43;
  background: #fbe4df;
  font-size: 34rpx;
  font-weight: 700;
}

.state-title,
.state-description,
.eyebrow,
.page-title,
.page-description,
.empty-title,
.empty-description,
.hangout-title,
.hangout-description,
.deadline-label,
.deadline-value,
.list-end,
.refresh-error text,
.pagination-error text {
  display: block;
}

.state-title {
  color: #1d2922;
  font-size: 34rpx;
  font-weight: 650;
}

.state-description {
  max-width: 520rpx;
  margin-bottom: 12rpx;
  color: #788179;
  font-size: 25rpx;
  line-height: 1.6;
}

.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.header-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: #718078;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.page-title {
  margin-top: 14rpx;
  color: #17231d;
  font-size: 44rpx;
  font-weight: 700;
}

.page-description {
  max-width: 500rpx;
  margin-top: 13rpx;
  color: #69746d;
  font-size: 23rpx;
  line-height: 1.6;
}

.refresh-error {
  margin-top: 24rpx;
  padding: 19rpx 22rpx;
  border-radius: 19rpx;
  color: #8b3d35;
  background: #fff0ed;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.retry-link {
  margin-top: 7rpx;
  color: #167d5d;
  font-weight: 650;
}

.empty-card {
  display: flex;
  margin-top: 46rpx;
  padding: 54rpx 34rpx;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #e5e9e4;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(35, 56, 45, 0.05);
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 25rpx;
  color: #176c52;
  background: #dff1e9;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-title {
  margin-top: 25rpx;
  color: #1d2922;
  font-size: 31rpx;
  font-weight: 650;
}

.empty-description {
  max-width: 500rpx;
  margin: 12rpx 0 28rpx;
  color: #7d8780;
  font-size: 23rpx;
  line-height: 1.6;
}

.hangout-list {
  margin-top: 34rpx;
}

.hangout-card {
  padding: 28rpx 27rpx 25rpx;
  border: 1rpx solid #e5e9e4;
  border-radius: 27rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 38rpx rgba(35, 56, 45, 0.045);
}

.hangout-card + .hangout-card {
  margin-top: 18rpx;
}

.card-heading {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.hangout-title {
  display: -webkit-box;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #1c2922;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.45;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.status-pill {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 650;
}

.status-draft {
  color: #6e5a27;
  background: #f7edcf;
}

.status-voting {
  color: #176348;
  background: #dcf0e7;
}

.status-confirmed {
  color: #315f8d;
  background: #e1edf8;
}

.status-cancelled,
.status-finished {
  color: #68716b;
  background: #ecefeb;
}

.hangout-description {
  display: -webkit-box;
  margin-top: 13rpx;
  overflow: hidden;
  color: #77827a;
  font-size: 23rpx;
  line-height: 1.55;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.deadline-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 19rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid #edf0eb;
}

.deadline-label {
  flex: 0 0 auto;
  color: #8f9891;
  font-size: 20rpx;
}

.deadline-value {
  flex: 1;
  color: #536058;
  font-size: 21rpx;
  line-height: 1.45;
  text-align: right;
}

.pagination-state,
.pagination-error,
.list-end {
  padding: 28rpx 0;
  color: #7b867e;
  font-size: 22rpx;
  text-align: center;
}

.list-end {
  color: #a0a8a2;
  font-size: 21rpx;
}
