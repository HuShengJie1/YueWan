.hangout-detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 38rpx 36rpx calc(42rpx + env(safe-area-inset-bottom));
  background: #f6f7f2;
}

.center-state {
  display: flex;
  min-height: 76vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  text-align: center;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  color: #a94d43;
  background: #fbe4df;
  font-size: 34rpx;
  font-weight: 700;
}

.state-title,
.state-description,
.hangout-title,
.hangout-description,
.info-label,
.info-value,
.next-step-eyebrow,
.next-step-title,
.next-step-description {
  display: block;
}

.state-title {
  color: #1d2922;
  font-size: 34rpx;
  font-weight: 650;
}

.state-description {
  max-width: 520rpx;
  margin-bottom: 12rpx;
  color: #788179;
  font-size: 25rpx;
  line-height: 1.6;
}

.detail-hero {
  padding: 34rpx 30rpx 39rpx;
  border-radius: 32rpx;
  background: #174f3e;
  box-shadow: 0 22rpx 56rpx rgba(23, 79, 62, 0.18);
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.status-pill {
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 650;
}

.status-draft {
  color: #f8eac4;
  background: rgba(244, 190, 72, 0.18);
}

.status-voting {
  color: #d7f1e6;
  background: rgba(95, 201, 157, 0.18);
}

.status-confirmed {
  color: #dcecff;
  background: rgba(109, 166, 225, 0.2);
}

.status-cancelled,
.status-finished {
  color: #dce3de;
  background: rgba(255, 255, 255, 0.13);
}

.group-caption {
  overflow: hidden;
  color: #b9d1c8;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hangout-title {
  margin-top: 25rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.hangout-description {
  margin-top: 16rpx;
  color: #c7d9d2;
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-word;
}

.info-card {
  margin-top: 24rpx;
  overflow: hidden;
  border: 1rpx solid #e5e9e4;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(35, 56, 45, 0.05);
}

.info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 116rpx;
  padding: 18rpx 25rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid #edf0eb;
}

.info-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  color: #176348;
  background: #dff1e9;
  font-size: 20rpx;
  font-weight: 700;
}

.deadline-icon {
  color: #815f1f;
  background: #f7edcf;
}

.info-copy {
  flex: 1;
  min-width: 0;
}

.info-label {
  color: #8b948d;
  font-size: 20rpx;
}

.info-value {
  margin-top: 7rpx;
  color: #2b3830;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}

.next-step-card {
  margin-top: 24rpx;
  padding: 27rpx 28rpx;
  border: 1rpx dashed #cfd8d1;
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.54);
}

.next-step-eyebrow {
  color: #167d5d;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.next-step-title {
  margin-top: 11rpx;
  color: #2b3830;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.5;
}

.next-step-description {
  margin-top: 8rpx;
  color: #7c867f;
  font-size: 22rpx;
  line-height: 1.6;
}

.edit-action {
  margin-top: 34rpx;
}
