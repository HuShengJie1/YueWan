.hangout-detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 38rpx 36rpx calc(42rpx + env(safe-area-inset-bottom));
  background: #f6f7f2;
}

.center-state {
  display: flex;
  min-height: 76vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  text-align: center;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  color: #a94d43;
  background: #fbe4df;
  font-size: 34rpx;
  font-weight: 700;
}

.state-title,
.state-description,
.hangout-title,
.hangout-description,
.info-label,
.info-value,
.section-title,
.section-subtitle,
.empty-title,
.empty-description,
.candidate-title,
.candidate-description,
.candidate-created,
.time-date,
.time-label,
.time-value-label,
.time-value,
.list-end,
.phase-note-eyebrow,
.phase-note-title,
.phase-note-description {
  display: block;
}

.state-title {
  color: #1d2922;
  font-size: 34rpx;
  font-weight: 650;
}

.state-description {
  max-width: 520rpx;
  margin-bottom: 12rpx;
  color: #788179;
  font-size: 25rpx;
  line-height: 1.6;
}

.detail-hero {
  padding: 34rpx 30rpx 39rpx;
  border-radius: 32rpx;
  background: #174f3e;
  box-shadow: 0 22rpx 56rpx rgba(23, 79, 62, 0.18);
}

.hero-meta,
.section-heading,
.candidate-card-heading,
.location-row,
.external-link-hint,
.time-range {
  display: flex;
  align-items: center;
}

.hero-meta {
  gap: 15rpx;
}

.status-pill {
  padding: 8rpx 15rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 650;
}

.status-draft {
  color: #f8eac4;
  background: rgba(244, 190, 72, 0.18);
}

.status-voting {
  color: #d7f1e6;
  background: rgba(95, 201, 157, 0.18);
}

.status-confirmed {
  color: #dcecff;
  background: rgba(109, 166, 225, 0.2);
}

.status-cancelled,
.status-finished {
  color: #dce3de;
  background: rgba(255, 255, 255, 0.13);
}

.group-caption {
  overflow: hidden;
  color: #b9d1c8;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hangout-title {
  margin-top: 25rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-word;
}

.hangout-description {
  margin-top: 16rpx;
  color: #c7d9d2;
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-word;
}

.refresh-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 21rpx;
  border-radius: 19rpx;
  color: #91483f;
  background: #fff0ed;
  font-size: 21rpx;
  line-height: 1.45;
}

.retry-link {
  flex: 0 0 auto;
  color: #167d5d;
  font-weight: 650;
}

.info-card {
  margin-top: 24rpx;
  overflow: hidden;
  border: 1rpx solid #e5e9e4;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(35, 56, 45, 0.05);
}

.info-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 116rpx;
  padding: 18rpx 25rpx;
}

.info-row + .info-row {
  border-top: 1rpx solid #edf0eb;
}

.info-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  color: #176348;
  background: #dff1e9;
  font-size: 20rpx;
  font-weight: 700;
}

.deadline-icon {
  color: #815f1f;
  background: #f7edcf;
}

.info-copy,
.section-copy,
.time-heading-copy {
  flex: 1;
  min-width: 0;
}

.info-label {
  color: #8b948d;
  font-size: 20rpx;
}

.info-value {
  margin-top: 7rpx;
  color: #2b3830;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}

.candidate-section {
  margin-top: 42rpx;
}

.time-section {
  margin-top: 48rpx;
}

.section-heading {
  justify-content: space-between;
  gap: 22rpx;
  padding: 0 4rpx;
}

.section-title {
  color: #1b2821;
  font-size: 31rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 5rpx;
  color: #929b94;
  font-size: 20rpx;
}

.section-refresh-error {
  margin-top: 15rpx;
}

.section-state-card,
.section-error-card,
.section-empty-card {
  margin-top: 18rpx;
  border: 1rpx solid #e5e9e4;
  border-radius: 27rpx;
  background: #ffffff;
}

.section-state-card {
  padding: 38rpx 24rpx;
  color: #6f7b73;
  text-align: center;
}

.section-error-card {
  padding: 28rpx 24rpx 20rpx;
  color: #91483f;
  background: #fff8f6;
  font-size: 22rpx;
  line-height: 1.55;
  text-align: center;
}

.section-error-card > text {
  display: block;
  margin-bottom: 8rpx;
}

.section-empty-card {
  display: flex;
  padding: 38rpx 28rpx;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 21rpx;
  color: #176c52;
  background: #dff1e9;
  font-size: 25rpx;
  font-weight: 700;
}

.time-empty-icon {
  color: #805e21;
  background: #f7edcf;
}

.empty-title {
  margin-top: 20rpx;
  color: #26332b;
  font-size: 28rpx;
  font-weight: 650;
}

.empty-description {
  max-width: 500rpx;
  margin: 10rpx 0 24rpx;
  color: #7f8982;
  font-size: 22rpx;
  line-height: 1.6;
}

.candidate-list {
  margin-top: 18rpx;
}

.proposal-card,
.time-option-card {
  padding: 25rpx 25rpx 23rpx;
  border: 1rpx solid #e5e9e4;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 13rpx 36rpx rgba(35, 56, 45, 0.04);
}

.proposal-card + .proposal-card,
.time-option-card + .time-option-card {
  margin-top: 15rpx;
}

.candidate-card-heading {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.candidate-title {
  flex: 1;
  min-width: 0;
  color: #1c2922;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.45;
  word-break: break-word;
}

.candidate-actions {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  margin: -12rpx -12rpx 0 0;
}

.location-row {
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 14rpx;
  color: #536058;
  font-size: 22rpx;
  line-height: 1.5;
}

.location-marker,
.link-marker {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 31rpx;
  height: 31rpx;
  border-radius: 9rpx;
  font-size: 17rpx;
  font-weight: 700;
}

.location-marker {
  margin-top: 1rpx;
  color: #176348;
  background: #dff1e9;
}

.location-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.candidate-description {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #78827b;
  font-size: 22rpx;
  line-height: 1.58;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.external-link-hint {
  align-items: center;
  gap: 9rpx;
  margin-top: 15rpx;
  color: #776022;
  font-size: 20rpx;
}

.link-marker {
  color: #805e21;
  background: #f7edcf;
}

.candidate-created {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf0eb;
  color: #969e98;
  font-size: 19rpx;
}

.time-date {
  color: #1c2922;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}

.time-label {
  margin-top: 5rpx;
  overflow: hidden;
  color: #7d8880;
  font-size: 20rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time-range {
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 21rpx 22rpx;
  border-radius: 20rpx;
  background: #f7f9f5;
}

.time-value-block {
  flex: 0 0 auto;
}

.end-time-block {
  flex: 1;
  min-width: 0;
  text-align: right;
}

.time-value-label {
  color: #929b94;
  font-size: 18rpx;
}

.time-value {
  margin-top: 5rpx;
  color: #26342c;
  font-size: 27rpx;
  font-weight: 650;
}

.time-value-muted {
  color: #8e9891;
  font-size: 21rpx;
  font-weight: 500;
}

.time-range-line {
  flex: 1;
  height: 2rpx;
  background: #dce3dc;
}

.pagination-state,
.pagination-error {
  margin-top: 18rpx;
  padding: 18rpx 16rpx;
  text-align: center;
}

.pagination-error {
  border-radius: 18rpx;
  color: #91483f;
  background: #fff0ed;
  font-size: 21rpx;
  line-height: 1.5;
}

.pagination-error text {
  display: block;
}

.pagination-error .retry-link {
  margin-top: 5rpx;
}

.list-end {
  padding: 23rpx 0 5rpx;
  color: #969f98;
  font-size: 20rpx;
  text-align: center;
}

.phase-note-card {
  margin-top: 38rpx;
  padding: 27rpx 28rpx;
  border: 1rpx dashed #cfd8d1;
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.54);
}

.phase-note-eyebrow {
  color: #167d5d;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.phase-note-title {
  margin-top: 11rpx;
  color: #2b3830;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.5;
}

.phase-note-description {
  margin-top: 8rpx;
  color: #7c867f;
  font-size: 22rpx;
  line-height: 1.6;
}

.edit-action {
  margin-top: 34rpx;
}

.voting-closed-card,
.voting-state-card,
.time-vote-save-card,
.waiting-voting-card {
  margin-top: 24rpx;
  border-radius: 25rpx;
}

.voting-closed-card {
  padding: 24rpx 26rpx;
  border: 1rpx solid #e8c7a5;
  color: #704d26;
  background: #fff5e7;
}

.voting-closed-title,
.voting-closed-description,
.proposal-vote-label,
.proposal-vote-caption,
.proposal-vote-count,
.time-vote-save-hint {
  display: block;
}

.voting-closed-title {
  font-size: 27rpx;
  font-weight: 700;
}

.voting-closed-description {
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.55;
}

.voting-state-card {
  padding: 42rpx 24rpx;
  border: 1rpx solid #e5e9e4;
  background: #ffffff;
  color: #6f7b73;
  text-align: center;
}

.vote-inline-error {
  margin-top: 16rpx;
  padding: 17rpx 20rpx;
  border-radius: 18rpx;
  color: #91483f;
  background: #fff0ed;
  font-size: 21rpx;
  line-height: 1.5;
}

.voting-proposal-card {
  transition: opacity 160ms ease;
}

.proposal-submit-state {
  flex: 0 0 auto;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  color: #176348;
  background: #dff1e9;
  font-size: 18rpx;
  font-weight: 650;
}

.proposal-vote-options {
  display: flex;
  gap: 10rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf0eb;
}

.proposal-vote-option {
  box-sizing: border-box;
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 138rpx;
  padding: 15rpx 5rpx 13rpx;
  border: 2rpx solid #e1e6e1;
  border-radius: 19rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5f6962;
  background: #fafbf8;
  text-align: center;
}

.proposal-vote-label {
  max-width: 100%;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  text-overflow: ellipsis;
}

.proposal-vote-caption {
  margin-top: 4rpx;
  font-size: 17rpx;
}

.proposal-vote-count {
  margin-top: 10rpx;
  color: #26332b;
  font-size: 22rpx;
  font-weight: 700;
}

.vote-like.proposal-vote-option-selected {
  border-color: #2f876b;
  color: #145a43;
  background: #e1f2eb;
  box-shadow: inset 0 0 0 2rpx rgba(47, 135, 107, 0.12);
}

.vote-ok.proposal-vote-option-selected {
  border-color: #a97a22;
  color: #725015;
  background: #fbf0d2;
  box-shadow: inset 0 0 0 2rpx rgba(169, 122, 34, 0.12);
}

.vote-dislike.proposal-vote-option-selected {
  border-color: #b2675e;
  color: #7d3f38;
  background: #f9e7e4;
  box-shadow: inset 0 0 0 2rpx rgba(178, 103, 94, 0.12);
}

.proposal-vote-option-disabled {
  opacity: 0.48;
}

.voting-time-card {
  border-width: 2rpx;
}

.voting-time-card-selected {
  border-color: #3a8a70;
  background: #fbfffd;
}

.voting-time-card-unsaved {
  border-style: dashed;
  border-color: #bb8526;
  background: #fffdf6;
}

.voting-time-card-disabled {
  opacity: 0.58;
}

.time-selection-control {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-width: 78rpx;
  height: 48rpx;
  padding: 0 11rpx;
  border: 2rpx solid #cfd8d1;
  border-radius: 15rpx;
  color: #657068;
  background: #ffffff;
  font-size: 19rpx;
  font-weight: 650;
}

.voting-time-card-selected .time-selection-control {
  border-color: #26765d;
  color: #ffffff;
  background: #26765d;
}

.time-vote-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 17rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #edf0eb;
  font-size: 20rpx;
}

.availability-count {
  color: #4e5b53;
  font-weight: 650;
}

.selection-state {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 650;
}

.selection-saved {
  color: #176348;
  background: #dff1e9;
}

.selection-unsaved {
  color: #7a561a;
  background: #f8ecc9;
}

.selection-idle {
  color: #7d8780;
  background: #eef1ed;
}

.time-vote-save-card {
  padding: 24rpx;
  border: 1rpx solid #dfe5df;
  background: #ffffff;
  box-shadow: 0 13rpx 36rpx rgba(35, 56, 45, 0.05);
}

.time-vote-save-hint {
  margin-bottom: 17rpx;
  color: #6e7971;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.time-save-error {
  margin: 0 0 17rpx;
}

.start-voting-action {
  margin-top: 28rpx;
}

.waiting-voting-card {
  padding: 22rpx 24rpx;
  border: 1rpx solid #dfe5df;
  color: #707b73;
  background: #ffffff;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.start-voting-action + .edit-action {
  margin-top: 18rpx;
}

.event-state-card {
  margin-top: 24rpx;
  padding: 38rpx 24rpx;
  border: 1rpx solid #dfe5df;
  border-radius: 25rpx;
  color: #6f7b73;
  background: #ffffff;
  text-align: center;
}

.event-card {
  margin-top: 26rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid #c9dfd5;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #fbfffc, #edf8f2);
  box-shadow: 0 15rpx 42rpx rgba(34, 81, 61, 0.08);
}

.event-card-heading,
.event-detail-row {
  display: flex;
}

.event-card-heading {
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
}

.event-title-copy {
  min-width: 0;
}

.event-eyebrow,
.event-title,
.event-description,
.event-confirmation-state,
.confirm-event-hint {
  display: block;
}

.event-eyebrow {
  color: #327861;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.event-title {
  margin-top: 7rpx;
  color: #1e2c24;
  font-size: 36rpx;
  font-weight: 760;
  line-height: 1.35;
}

.event-status-pill {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #176348;
  background: #dff1e9;
  font-size: 19rpx;
  font-weight: 700;
}

.event-description {
  margin-top: 16rpx;
  color: #66736b;
  font-size: 22rpx;
  line-height: 1.55;
}

.event-detail-row {
  gap: 20rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(45, 116, 86, 0.13);
}

.event-detail-label {
  flex: 0 0 64rpx;
  color: #738078;
  font-size: 20rpx;
}

.event-detail-value {
  flex: 1;
  color: #27352c;
  font-size: 22rpx;
  font-weight: 620;
  line-height: 1.45;
}

.event-confirmation-state {
  margin-top: 23rpx;
  padding: 13rpx 17rpx;
  border-radius: 16rpx;
  color: #176348;
  background: rgba(218, 239, 228, 0.72);
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}

.confirm-event-action {
  margin-top: 28rpx;
}

.confirm-event-hint {
  margin-top: 12rpx;
  color: #7a857e;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}
