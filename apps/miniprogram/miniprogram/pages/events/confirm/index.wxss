.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 34rpx 28rpx 70rpx;
}

.center-state {
  display: flex;
  min-height: 72vh;
  padding: 40rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-icon {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  color: #9a473d;
  background: #fbe8e5;
  font-size: 42rpx;
  font-weight: 700;
}

.state-title,
.state-description,
.eyebrow,
.page-title,
.page-description,
.page-hint,
.official-eyebrow,
.official-title,
.section-step,
.section-title,
.result-title,
.result-location,
.result-description,
.vote-label,
.vote-value,
.time-label,
.time-value,
.availability-count,
.preview-label,
.preview-value,
.submit-hint,
.message-action {
  display: block;
}

.state-title {
  margin-top: 26rpx;
  font-size: 34rpx;
  font-weight: 750;
}

.state-description {
  max-width: 580rpx;
  margin: 14rpx 0 30rpx;
  color: #6b776f;
  font-size: 23rpx;
  line-height: 1.65;
}

.confirm-hero {
  padding: 20rpx 8rpx 28rpx;
}

.eyebrow,
.official-eyebrow,
.section-step {
  color: #327861;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.page-title {
  margin-top: 9rpx;
  font-size: 47rpx;
  font-weight: 780;
  letter-spacing: -1rpx;
}

.page-description {
  margin-top: 13rpx;
  color: #34433a;
  font-size: 25rpx;
  font-weight: 650;
}

.page-hint {
  margin-top: 9rpx;
  color: #748078;
  font-size: 21rpx;
  line-height: 1.55;
}

.refreshing-row {
  padding: 17rpx 0;
  text-align: center;
}

.message-card {
  margin: 16rpx 0;
  padding: 20rpx 22rpx;
  border: 1rpx solid;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.55;
}

.error-card {
  border-color: #efcbc5;
  color: #8c4139;
  background: #fff0ed;
}

.notice-card {
  border-color: #e8d29e;
  color: #725318;
  background: #fff8e5;
}

.permission-card,
.status-card {
  border-color: #d8e1da;
  color: #536159;
  background: #ffffff;
}

.message-action {
  margin-top: 5rpx;
  font-weight: 700;
}

.official-event-card {
  margin-top: 18rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid #cfe1d8;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #f9fffb, #eef8f2);
  box-shadow: 0 15rpx 40rpx rgba(33, 81, 61, 0.08);
}

.official-heading,
.result-card-heading,
.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
}

.official-title {
  margin-top: 7rpx;
  font-size: 38rpx;
  font-weight: 760;
}

.confirmed-pill,
.selection-summary {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #176348;
  background: #dff1e9;
  font-size: 19rpx;
  font-weight: 700;
}

.official-detail-row {
  display: flex;
  gap: 22rpx;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(47, 120, 88, 0.13);
}

.detail-label {
  flex: 0 0 68rpx;
  color: #718078;
  font-size: 21rpx;
}

.detail-value {
  flex: 1;
  color: #24332a;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.45;
}

.result-section {
  margin-top: 30rpx;
}

.time-result-section {
  margin-top: 42rpx;
}

.section-title {
  margin-top: 6rpx;
  font-size: 31rpx;
  font-weight: 740;
}

.selection-summary {
  color: #65726a;
  background: #e9eeea;
}

.result-list {
  display: flex;
  margin-top: 18rpx;
  gap: 18rpx;
  flex-direction: column;
}

.proposal-result-card,
.time-result-card,
.empty-card,
.submit-card {
  padding: 25rpx;
  border: 2rpx solid #e0e5df;
  border-radius: 25rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(35, 56, 45, 0.045);
}

.result-card-selected {
  border-color: #2e8468;
  background: #f9fffb;
  box-shadow: inset 0 0 0 2rpx rgba(46, 132, 104, 0.09);
}

.result-card-readonly {
  opacity: 0.76;
}

.result-heading-copy {
  min-width: 0;
}

.result-title {
  color: #1d2922;
  font-size: 28rpx;
  font-weight: 720;
  line-height: 1.4;
}

.result-location {
  margin-top: 6rpx;
  color: #68756d;
  font-size: 21rpx;
  line-height: 1.45;
}

.radio-mark {
  display: flex;
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid #c7d0ca;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 750;
}

.result-card-selected .radio-mark {
  border-color: #26765d;
  background: #26765d;
}

.result-description {
  margin-top: 16rpx;
  color: #68756d;
  font-size: 21rpx;
  line-height: 1.55;
}

.vote-counts {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0eb;
}

.vote-count {
  flex: 1;
  padding: 12rpx 8rpx;
  border-radius: 15rpx;
  text-align: center;
}

.vote-like {
  color: #176348;
  background: #e5f3ed;
}

.vote-ok {
  color: #745418;
  background: #faf0d6;
}

.vote-dislike {
  color: #87483f;
  background: #f9e8e5;
}

.vote-label {
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.vote-value {
  margin-top: 3rpx;
  font-size: 26rpx;
  font-weight: 760;
}

.time-range {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f5f7f3;
}

.time-block {
  flex: 1;
  min-width: 0;
}

.time-end {
  text-align: right;
}

.time-label {
  color: #78847c;
  font-size: 18rpx;
}

.time-value {
  margin-top: 5rpx;
  color: #27342c;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
}

.time-muted {
  color: #89938c;
  font-weight: 500;
}

.time-divider {
  width: 36rpx;
  height: 2rpx;
  margin: 0 18rpx;
  background: #bdc8c0;
}

.availability-count {
  margin-top: 16rpx;
  color: #327861;
  font-size: 21rpx;
  font-weight: 700;
}

.empty-card {
  margin-top: 18rpx;
  color: #748078;
  font-size: 22rpx;
  text-align: center;
}

.submit-error {
  margin-top: 26rpx;
}

.submit-card {
  margin-top: 30rpx;
  padding: 26rpx;
  border-width: 1rpx;
}

.selection-preview {
  margin-bottom: 22rpx;
  padding: 19rpx 21rpx;
  border-radius: 18rpx;
  background: #f4f7f3;
}

.preview-label {
  color: #728078;
  font-size: 18rpx;
  font-weight: 700;
}

.preview-value {
  margin-top: 7rpx;
  color: #26332b;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.45;
}

.preview-time {
  color: #5f6e65;
  font-size: 21rpx;
  font-weight: 500;
}

.submit-hint {
  margin-top: 14rpx;
  color: #7c8780;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}
