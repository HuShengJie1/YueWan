.detail-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 38rpx 36rpx calc(42rpx + env(safe-area-inset-bottom));
  background: #f6f7f2;
}

.center-state {
  display: flex;
  min-height: 76vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  text-align: center;
}

.state-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  color: #a94d43;
  background: #fbe4df;
  font-size: 34rpx;
  font-weight: 700;
}

.state-title,
.state-description,
.group-name,
.group-description,
.invite-title,
.invite-description,
.member-name,
.member-role,
.list-end,
.danger-title,
.danger-description,
.delete-dialog-title,
.delete-dialog-description,
.confirmation-label {
  display: block;
}

.state-title {
  color: #1d2922;
  font-size: 34rpx;
  font-weight: 650;
}

.state-description {
  max-width: 520rpx;
  margin-bottom: 12rpx;
  color: #788179;
  font-size: 25rpx;
  line-height: 1.6;
}

.group-hero {
  padding: 34rpx 30rpx 38rpx;
  border-radius: 32rpx;
  background: #174f3e;
  box-shadow: 0 22rpx 56rpx rgba(23, 79, 62, 0.18);
}

.group-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 21rpx;
  color: #174f3e;
  background: #dff1e9;
  font-size: 27rpx;
  font-weight: 700;
}

.hero-meta,
.section-heading,
.member-row {
  display: flex;
  align-items: center;
}

.hero-meta {
  gap: 14rpx;
  margin-top: 28rpx;
}

.role-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #d9eee6;
  background: rgba(255, 255, 255, 0.12);
  font-size: 19rpx;
  font-weight: 650;
}

.role-owner {
  color: #f8eac4;
  background: rgba(244, 190, 72, 0.16);
}

.member-count {
  color: #b9d1c8;
  font-size: 21rpx;
}

.group-name {
  margin-top: 18rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.3;
}

.group-description {
  margin-top: 13rpx;
  color: #c7d9d2;
  font-size: 24rpx;
  line-height: 1.65;
}

.invite-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(23, 35, 29, 0.06);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(35, 56, 45, 0.05);
}

.invite-copy {
  margin-bottom: 22rpx;
}

.invite-title {
  color: #1c2922;
  font-size: 28rpx;
  font-weight: 650;
}

.invite-description {
  margin-top: 8rpx;
  color: #7f8982;
  font-size: 22rpx;
  line-height: 1.55;
}

.invite-state {
  padding: 13rpx 0;
  color: #69756d;
  text-align: center;
}

.invite-error {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  color: #91483f;
  background: #fff0ed;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.invite-error text,
.pagination-error text {
  display: block;
}

.retry-link {
  margin-top: 8rpx;
  color: #167d5d;
  font-weight: 650;
}

.section-heading {
  justify-content: space-between;
  margin-top: 42rpx;
  padding: 0 4rpx;
}

.section-title {
  color: #1b2821;
  font-size: 31rpx;
  font-weight: 700;
}

.section-count {
  color: #8b948d;
  font-size: 22rpx;
}

.member-list {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e7eae5;
  border-radius: 28rpx;
  background: #ffffff;
}

.member-row {
  gap: 20rpx;
  min-height: 112rpx;
  padding: 14rpx 24rpx;
}

.member-row + .member-row {
  border-top: 1rpx solid #edf0eb;
}

.member-copy {
  flex: 1;
  min-width: 0;
}

.member-name {
  overflow: hidden;
  color: #233028;
  font-size: 27rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-role {
  margin-top: 6rpx;
  color: #8a938c;
  font-size: 21rpx;
}

.owner-badge {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #8c641a;
  background: #f8eccd;
  font-size: 18rpx;
  font-weight: 650;
}

.pagination-state,
.pagination-error,
.list-end {
  padding: 24rpx 0;
  color: #7b867e;
  font-size: 22rpx;
  text-align: center;
}

.list-end {
  color: #a0a8a2;
  font-size: 21rpx;
}

.danger-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  margin-top: 38rpx;
  padding: 25rpx 27rpx;
  border: 1rpx solid #edd8d4;
  border-radius: 24rpx;
  background: #fffdfc;
}

.danger-copy {
  flex: 1;
  min-width: 0;
}

.danger-title {
  color: #803f38;
  font-size: 24rpx;
  font-weight: 650;
}

.danger-description {
  margin-top: 7rpx;
  color: #98736f;
  font-size: 20rpx;
  line-height: 1.55;
}

.delete-layer {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.delete-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(18, 29, 23, 0.56);
}

.delete-dialog {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  max-height: calc(100vh - 80rpx);
  padding: 34rpx 30rpx 30rpx;
  overflow-y: auto;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 90rpx rgba(25, 39, 31, 0.24);
}

.delete-warning-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  color: #a8443b;
  background: #fbe5e1;
  font-size: 29rpx;
  font-weight: 700;
}

.delete-dialog-title {
  margin-top: 22rpx;
  color: #2b2524;
  font-size: 34rpx;
  font-weight: 700;
}

.delete-dialog-description {
  margin-top: 13rpx;
  color: #726562;
  font-size: 23rpx;
  line-height: 1.65;
}

.delete-impact-list {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  color: #7a4d48;
  background: #fff4f2;
  font-size: 22rpx;
  line-height: 1.8;
}

.delete-impact-list text {
  display: block;
}

.confirmation-field {
  margin-top: 26rpx;
}

.confirmation-label {
  color: #3d3836;
  font-size: 23rpx;
  font-weight: 600;
}

.confirmation-name {
  margin-top: 10rpx;
  padding: 14rpx 18rpx;
  border-radius: 15rpx;
  color: #743d37;
  background: #f7eeec;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.5;
  word-break: break-all;
}

.confirmation-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 21rpx;
  border: 2rpx solid #e1d8d5;
  border-radius: 19rpx;
  color: #2c2927;
  background: #ffffff;
  font-size: 27rpx;
}

.confirmation-input-error {
  border-color: #ce766c;
}

.confirmation-placeholder {
  color: #aaa19e;
}

.delete-error {
  display: flex;
  align-items: flex-start;
  gap: 11rpx;
  margin-top: 15rpx;
  color: #a14b42;
  font-size: 21rpx;
  line-height: 1.5;
}

.delete-error-dot {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 27rpx;
  height: 27rpx;
  margin-top: 2rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #c95e51;
  font-size: 17rpx;
  font-weight: 700;
}

.delete-dialog-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.delete-dialog-action {
  flex: 1;
  min-width: 0;
}
